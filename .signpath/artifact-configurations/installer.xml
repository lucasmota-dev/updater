<?xml version="1.0" encoding="utf-8"?>
<!-- Configuração "installer" no SignPath: assina o instalador gerado pelo Inno Setup.
     O executável dentro dele já foi assinado pela configuração "app-exe". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <zip-file>
    <pe-file path="Atualizador-Setup.exe" product-name="App Updater" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
