<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#0067C0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrushHover" Color="#005A9E" />
    <SolidColorBrush x:Key="AccentBrushPressed" Color="#004578" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleAccentBrush" Color="#160067C0" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#350067C0" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0067C0" />
</ResourceDictionary>
