<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cores do tema escuro. O AppearanceService troca este arquivo pelo Theme.Light.xaml em tempo de execução;
         por isso as telas usam sempre DynamicResource. As chaves devem ser as mesmas nos dois temas. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#444444" />
    <SolidColorBrush x:Key="DisabledControlBrush" Color="#333333" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#454545" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C7C7C7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#6A6A6A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F8D775" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#30FF99A4" />
</ResourceDictionary>
