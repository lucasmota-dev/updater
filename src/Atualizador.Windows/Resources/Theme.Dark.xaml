<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema escuro (tokens do design system HIG Inspired). No escuro, a profundidade vem de
         superfícies mais claras, não de sombras. As chaves devem ser as mesmas do Theme.Light.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000" />   <!-- surface -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1E" />            <!-- surface-raised -->
    <SolidColorBrush x:Key="SunkenBrush" Color="#2C2C2E" />             <!-- surface-sunken -->
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#242426" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="SunkenHoverBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="DisabledControlBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F7" />        <!-- label -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A1A6" />      <!-- label-secondary -->
    <SolidColorBrush x:Key="BorderBrush" Color="#38383A" />             <!-- separator -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#8E8E93" />      <!-- control-border -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#48484A" />
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#30D158" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#26FF453A" />
</ResourceDictionary>
