<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cores do tema claro. O AppearanceService troca este arquivo pelo Theme.Dark.xaml em tempo de execução;
         por isso as telas usam sempre DynamicResource. As chaves devem ser as mesmas nos dois temas. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="DisabledControlBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#18C42B1C" />
</ResourceDictionary>
