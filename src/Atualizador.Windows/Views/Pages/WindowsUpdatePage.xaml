<!--
    Página Windows Update (DataContext: WindowsUpdatePageViewModel).
    A procura roda sem administrador; a instalação abre uma cópia elevada do app (UAC).
    Quando o Windows pede reinício, aparece a faixa com "Reiniciar agora".
-->
<UserControl x:Class="Atualizador.Windows.Views.Pages.WindowsUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Margin="16,2,0,0" VerticalAlignment="Top"
                    Content="Procurar atualizações"
                    Command="{Binding SearchCommand}"
                    ToolTip="Consultar o Windows Update. Não precisa de permissão de administrador."
                    AutomationProperties.Name="Procurar atualizações do Windows"
                    Style="{DynamicResource PrimaryButtonStyle}" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{DynamicResource StatusPanelStyle}">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource StatusTextStyle}" />
                <TextBlock Margin="0,6,0,0" Text="{Binding ProgressDetail}" Style="{DynamicResource CaptionTextStyle}" />
                <ProgressBar Margin="0,10,0,0" Height="5" Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Style="{DynamicResource ProgressBarStyle}" />
            </StackPanel>
        </Border>

        <!-- Reinício pendente -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="14,10" CornerRadius="10"
                Background="{DynamicResource SubtleAccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsRebootRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                        Content="Reiniciar agora" Command="{Binding RestartCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="O Windows precisa reiniciar para concluir as atualizações. Salve o seu trabalho antes de reiniciar." />
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,16,0,0" Style="{DynamicResource ListCardStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{DynamicResource ActionFooterStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" Style="{DynamicResource ActionBarStyle}" Margin="0" VerticalAlignment="Center">
                            <Button Margin="{StaticResource ActionItemMargin}" Content="Abrir no Windows"
                                    Command="{Binding OpenWindowsSettingsCommand}"
                                    ToolTip="Abrir Configurações › Windows Update do próprio Windows."
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                            <TextBlock Margin="4,0,12,8" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="A instalação pede permissão de administrador."
                                       Style="{DynamicResource CaptionTextStyle}" />
                        </WrapPanel>
                        <Button Grid.Column="1" Margin="0,0,0,8" VerticalAlignment="Top"
                                Content="{Binding Updates.Count}" ContentStringFormat="Instalar atualizações ({0})"
                                Command="{Binding InstallCommand}"
                                AutomationProperties.Name="Instalar atualizações do Windows"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <Grid DockPanel.Dock="Top" Margin="16,10,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,8,0" Text="Atualização" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="1" Margin="0,0,8,0" Text="Categoria" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="2" Text="Tamanho máx." ToolTip="Tamanho máximo informado pelo Windows; o download real costuma ser menor." TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                </Grid>

                <Grid>
                    <TextBlock Margin="16,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding EmptyStateMessage}" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdates}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListView ItemsSource="{Binding Updates}"
                              Margin="8,0,8,4"
                              Style="{DynamicResource UpdateListStyle}"
                              ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                              AutomationProperties.Name="Atualizações do Windows disponíveis">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.7*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding KbArticle}" Style="{DynamicResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="0,0,8,0" Text="{Binding Category}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
