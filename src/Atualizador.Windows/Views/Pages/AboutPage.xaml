<!--
    Página Sobre (DataContext: AboutPageViewModel).
    O que o app faz, como funciona, por que foi criado, o autor, links e a atualização do próprio app.
    Os links usam OpenLinkCommand com uma chave fixa (veja AboutPageViewModel.Links).
-->
<UserControl x:Class="Atualizador.Windows.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BulletTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,24">
                <Border DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,16,0" CornerRadius="14"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="&#xE895;" FontSize="26" Foreground="{DynamicResource AccentForegroundBrush}"
                               Style="{DynamicResource IconTextStyle}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="App Updater" Style="{DynamicResource SectionTitleTextStyle}" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource CaptionTextStyle}">
                        <Run Text="{Binding AppUpdate.CurrentVersionText, Mode=OneWay}" /> • Licença MIT • Código aberto
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <GroupBox Header="O que é" Style="{DynamicResource SettingsGroupStyle}">
                <TextBlock TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}"
                           Text="O App Updater mantém o seu computador atualizado em um só lugar: os aplicativos instalados, pelo WinGet, e o próprio Windows, pelo Windows Update. Você vê o que tem versão nova, escolhe o que atualizar e acompanha o progresso, sem abrir o terminal." />
            </GroupBox>

            <GroupBox Header="Como funciona" Style="{DynamicResource SettingsGroupStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BulletTextStyle}" Margin="0"
                               Text="• Atualizações: consulta o WinGet, o gerenciador de pacotes oficial do Windows, e atualiza cada aplicativo pelo ID exato, um de cada vez." />
                    <TextBlock Style="{StaticResource BulletTextStyle}"
                               Text="• Instalar: pesquisa o catálogo do WinGet, mesmo com o nome digitado de forma aproximada, e instala os aplicativos escolhidos." />
                    <TextBlock Style="{StaticResource BulletTextStyle}"
                               Text="• Windows Update: procura as atualizações do sistema e as instala com a permissão de administrador, pedida só na hora da instalação." />
                    <TextBlock Style="{StaticResource BulletTextStyle}"
                               Text="• Agendamento e exclusões: atualiza sozinho no horário escolhido e nunca mexe nos aplicativos que você excluiu." />
                    <TextBlock Style="{StaticResource BulletTextStyle}"
                               Text="• Segurança: o app roda sem permissão de administrador, não executa comandos digitados e guarda o histórico só neste computador." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Por que foi criado" Style="{DynamicResource SettingsGroupStyle}">
                <TextBlock TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}"
                           Text="O App Updater nasceu de um script de manutenção que atualizava o Windows e todos os programas de uma vez. A ideia foi transformar esse script em um aplicativo seguro e fácil de usar, com controle sobre o que é atualizado, histórico e agendamento, para que qualquer pessoa consiga manter o computador em dia." />
            </GroupBox>

            <GroupBox Header="Criador" Style="{DynamicResource SettingsGroupStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Perfil no GitHub"
                            Command="{Binding OpenLinkCommand}" CommandParameter="author"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lucas Mota" Style="{DynamicResource LabelTextStyle}" />
                        <TextBlock Margin="0,2,0,0" Text="Desenvolvedor do App Updater" Style="{DynamicResource CaptionTextStyle}" />
                    </StackPanel>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Atualização do App Updater" Style="{DynamicResource SettingsGroupStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding AppUpdate.CurrentVersionText}" Style="{DynamicResource LabelTextStyle}" />
                    <CheckBox Margin="0,12,0,0"
                              IsChecked="{Binding AppUpdate.CheckOnStartup, Mode=TwoWay}"
                              Style="{DynamicResource CheckBoxStyle}"
                              Content="Procurar nova versão ao abrir o aplicativo" />
                    <TextBlock Margin="0,6,0,0"
                               Text="A busca consulta a página de releases do projeto no GitHub. Nenhum dado pessoal ou lista de aplicativos é enviado."
                               TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                    <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Buscar nova versão"
                            Command="{Binding AppUpdate.CheckCommand}"
                            ToolTip="Procurar uma versão mais nova do App Updater no GitHub e instalá-la."
                            AutomationProperties.Name="Buscar nova versão do App Updater"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding AppUpdate.StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Links" Style="{DynamicResource SettingsGroupStyle}">
                <WrapPanel Style="{DynamicResource ActionBarStyle}">
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Código-fonte" Command="{Binding OpenLinkCommand}" CommandParameter="repository" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Versões" Command="{Binding OpenLinkCommand}" CommandParameter="releases" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Relatar um problema" Command="{Binding OpenLinkCommand}" CommandParameter="issues" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Privacidade" Command="{Binding OpenLinkCommand}" CommandParameter="privacy" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Licença MIT" Command="{Binding OpenLinkCommand}" CommandParameter="license" Style="{DynamicResource SecondaryButtonStyle}" />
                </WrapPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
