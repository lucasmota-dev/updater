<!--
    Página Instalar (DataContext: InstallPageViewModel).
    ┌ título ───────────────────────────────────────────────┐
    │ [pesquisa ........................] [Pesquisar]       │
    │ caixa de estado                                        │
    │ ┌ resultados ──────────────────────────────────────┐  │
    │ │ [✓] Aplicativo  ID  Versão  Origem  Situação     │  │
    │ │ rodapé: filtro            [Adicionar à fila (N)] │  │
    │ └──────────────────────────────────────────────────┘  │
    │ ┌ fila de instalação (só aparece com itens) ───────┐  │
    │ │ 1 de 3 concluídos • instalando X  [Cancelar atual]│  │
    │ └──────────────────────────────────────────────────┘  │
    A pesquisa continua disponível enquanto a fila instala, um aplicativo por vez.
-->
<UserControl x:Class="Atualizador.Windows.Views.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
            <TextBlock Margin="0,2,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
        </StackPanel>

        <!-- Pesquisa: Enter no campo também pesquisa. -->
        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Pesquisar" Command="{Binding SearchCommand}"
                    AutomationProperties.Name="Pesquisar aplicativos"
                    Style="{DynamicResource PrimaryButtonStyle}" />
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Nome ou ID do aplicativo (ex.: firefox br, vscode, Mozilla.Firefox)"
                     AutomationProperties.Name="Termo de pesquisa do aplicativo"
                     Style="{DynamicResource SettingsTextBoxStyle}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <Border Grid.Row="2" Margin="0,12,0,12" Style="{DynamicResource StatusPanelStyle}">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource StatusTextStyle}" />
                <ProgressBar Margin="0,6,0,0" Minimum="0" Maximum="100" Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsIndeterminate="{Binding IsSearching, Mode=OneWay}"
                             Style="{DynamicResource ProgressBarStyle}" />
            </StackPanel>
        </Border>
        <!-- O aviso de procedência ("revise o publicador") aparece na confirmação antes de instalar. -->

        <!-- Resultados da pesquisa -->
        <Border Grid.Row="3" Style="{DynamicResource ListCardStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{DynamicResource ActionFooterStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Width="200" Margin="0,0,8,8" HorizontalAlignment="Left"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Filtrar resultados"
                                 ToolTip="Filtrar os resultados por nome, ID ou publicador"
                                 AutomationProperties.Name="Filtrar resultados da pesquisa"
                                 Style="{DynamicResource SettingsTextBoxStyle}" />
                        <Button Grid.Column="1" Margin="0,0,0,8" VerticalAlignment="Top"
                                Content="{Binding SelectedCount}" ContentStringFormat="Adicionar à fila ({0})"
                                Command="{Binding AddSelectedToQueueCommand}"
                                ToolTip="Adicionar os aplicativos marcados à fila. Eles são instalados um de cada vez."
                                AutomationProperties.Name="Adicionar selecionados à fila de instalação"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <!-- Cabeçalho: as colunas precisam ser iguais às do ItemTemplate. -->
                <Grid DockPanel.Dock="Top" Margin="16,10,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding AreAllSelected, Mode=TwoWay}" Style="{DynamicResource SelectAllCheckBoxStyle}" />
                    <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="Aplicativo e publicador" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="2" Margin="0,0,8,0" Text="Identificador (ID)" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="3" Margin="0,0,8,0" Text="Versão" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="4" Margin="0,0,8,0" Text="Origem" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                    <TextBlock Grid.Column="5" Margin="0,0,8,0" Text="Situação" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                </Grid>

                <Grid>
                    <TextBlock Margin="16,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Nenhum resultado para mostrar. Pesquise um aplicativo pelo nome ou ID."
                               TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListView ItemsSource="{Binding FilteredPackages}"
                              Margin="8,0,8,4"
                              Style="{DynamicResource UpdateListStyle}"
                              ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              AutomationProperties.Name="Lista de resultados para instalação">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ListView}}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Publisher}" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Version}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Fila de instalação -->
        <Border Grid.Row="4" Margin="0,12,0,0" Style="{DynamicResource ListCardStyle}"
                Visibility="{Binding HasQueue, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource SubtleAccentBrush}" CornerRadius="10,10,0,0">
                    <StackPanel>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" Style="{DynamicResource ActionBarStyle}" Margin="12,0,0,-8">
                                <Button Margin="{StaticResource ActionItemMargin}" Content="Cancelar atual"
                                        Command="{Binding CancelCurrentCommand}"
                                        ToolTip="Cancelar só a instalação em andamento; a fila continua com o próximo. O instalador externo pode não reverter alterações."
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Margin="0,0,0,8" Content="Limpar concluídos"
                                        Command="{Binding ClearFinishedCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </WrapPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Fila de instalação" Style="{DynamicResource StatusTextStyle}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding QueueSummary}" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Margin="0,8,0,0" Height="4" Minimum="0" Maximum="100"
                                     Value="{Binding QueueProgress, Mode=OneWay}"
                                     Style="{DynamicResource ProgressBarStyle}" />
                    </StackPanel>
                </Border>

                <ListView ItemsSource="{Binding Queue}" MaxHeight="190" Margin="8,4,8,6"
                          Style="{DynamicResource UpdateListStyle}"
                          ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                          AutomationProperties.Name="Fila de instalação">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="&#xE711;"
                                        ToolTip="Remover da fila"
                                        AutomationProperties.Name="Remover da fila"
                                        Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavigationToggleButtonStyle}">
                                            <Setter Property="Margin" Value="8,0,0,0" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPending}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock DockPanel.Dock="Right" Width="240" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding StatusMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource CaptionTextStyle}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}">
                                        <Run Text="{Binding Id, Mode=OneWay}" /> • <Run Text="{Binding Version, Mode=OneWay}" />
                                    </TextBlock>
                                    <ProgressBar Margin="0,4,0,0" Height="3" IsIndeterminate="True" Style="{DynamicResource ProgressBarStyle}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
