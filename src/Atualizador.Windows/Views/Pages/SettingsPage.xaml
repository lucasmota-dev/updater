<!--
    Página Configurações (DataContext: SettingsPageViewModel). Cada GroupBox é uma seção com o seu ViewModel.
    Layout de linhas de configuração (HIG): rótulo e explicação curta à esquerda, controle à direita,
    separador fino entre linhas. Os alternadores aplicam a mudança na hora (Command no próprio CheckBox).
-->
<UserControl x:Class="Atualizador.Windows.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Linha: o controle (último filho com DockPanel.Dock="Right") fica alinhado à direita. -->
        <Style x:Key="SettingRowStyle" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="RowSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="Fill" Value="{DynamicResource SeparatorBrush}" />
        </Style>
        <Style x:Key="RowComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="680" Margin="0,0,12,0" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
            <TextBlock Margin="0,2,0,16" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />

            <GroupBox Header="Aparência" Style="{DynamicResource SettingsGroupStyle}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingRowStyle}">
                        <ListBox DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                 ItemsSource="{Binding Appearance.AvailableModes}"
                                 SelectedItem="{Binding Appearance.SelectedMode, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource DisplayTextTemplate}"
                                 AutomationProperties.Name="Tema do aplicativo"
                                 Style="{DynamicResource SegmentedListBoxStyle}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tema" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Text="Claro, escuro ou igual ao Windows." Style="{DynamicResource OptionalCaptionTextStyle}" />
                        </StackPanel>
                    </DockPanel>

                    <Rectangle Style="{StaticResource RowSeparatorStyle}" />

                    <DockPanel Style="{StaticResource SettingRowStyle}">
                        <ComboBox ItemsSource="{Binding Appearance.AccentOptions}"
                                  SelectedItem="{Binding Appearance.SelectedAccent, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Cor de destaque predefinida"
                                  Style="{StaticResource RowComboBoxStyle}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cor de destaque" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Text="Usada no botão principal, na seleção e no foco." Style="{DynamicResource OptionalCaptionTextStyle}" />
                        </StackPanel>
                    </DockPanel>

                    <Rectangle Style="{StaticResource RowSeparatorStyle}" />

                    <DockPanel Style="{StaticResource SettingRowStyle}">
                        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="140" Text="{Binding Appearance.CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="#0071E3"
                                     AutomationProperties.Name="Código hexadecimal da cor"
                                     Style="{DynamicResource SettingsTextBoxStyle}" />
                            <Button Margin="8,0,0,0" Content="Aplicar"
                                    Command="{Binding Appearance.ApplyCustomAccentCommand}"
                                    AutomationProperties.Name="Aplicar cor personalizada"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cor personalizada" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Text="{Binding Appearance.ValidationMessage}" Foreground="{DynamicResource ErrorBrush}" Style="{DynamicResource OptionalCaptionTextStyle}" />
                        </StackPanel>
                    </DockPanel>

                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="Restaurar aparência padrão"
                            Command="{Binding Appearance.RestoreDefaultsCommand}"
                            Style="{DynamicResource PlainButtonStyle}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Agendamento" Style="{DynamicResource SettingsGroupStyle}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SettingRowStyle}">
                        <ComboBox ItemsSource="{Binding Schedule.AvailableModes}"
                                  SelectedItem="{Binding Schedule.Mode, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DisplayTextTemplate}"
                                  AutomationProperties.Name="Frequência do agendamento"
                                  Style="{StaticResource RowComboBoxStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Frequência" Style="{DynamicResource LabelTextStyle}" />
                    </DockPanel>
                    <Rectangle Style="{StaticResource RowSeparatorStyle}" />
                    <DockPanel Style="{StaticResource SettingRowStyle}">
                        <ComboBox ItemsSource="{Binding Schedule.AvailableIntervals}"
                                  SelectedItem="{Binding Schedule.IntervalHours, Mode=TwoWay}"
                                  ItemStringFormat="{}{0} h"
                                  AutomationProperties.Name="Intervalo em horas"
                                  Style="{StaticResource RowComboBoxStyle}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Intervalo" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Text="Para a frequência por intervalo de horas." Style="{DynamicResource OptionalCaptionTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource RowSeparatorStyle}" />
                    <DockPanel Style="{StaticResource SettingRowStyle}">
                        <ComboBox ItemsSource="{Binding Schedule.AvailableDays}"
                                  SelectedItem="{Binding Schedule.DayOfWeek, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DisplayTextTemplate}"
                                  AutomationProperties.Name="Dia do agendamento semanal"
                                  Style="{StaticResource RowComboBoxStyle}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dia da semana" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Text="Para a frequência semanal." Style="{DynamicResource OptionalCaptionTextStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource RowSeparatorStyle}" />
                    <DockPanel Style="{StaticResource SettingRowStyle}">
                        <ComboBox ItemsSource="{Binding Schedule.AvailableScopes}"
                                  SelectedItem="{Binding Schedule.Scope, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DisplayTextTemplate}"
                                  AutomationProperties.Name="Escopo do agendamento"
                                  Style="{StaticResource RowComboBoxStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="O que atualizar" Style="{DynamicResource LabelTextStyle}" />
                    </DockPanel>

                    <DockPanel Margin="0,12,0,0">
                        <WrapPanel DockPanel.Dock="Right" Style="{DynamicResource ActionBarStyle}">
                            <Button Margin="{StaticResource ActionItemMargin}" Content="Remover" Command="{Binding Schedule.RemoveCommand}" Style="{DynamicResource PlainButtonStyle}" />
                            <Button Margin="{StaticResource ActionItemMargin}" Content="Desativar" Command="{Binding Schedule.DisableCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,0,8" Content="Salvar agendamento" Command="{Binding Schedule.SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                        </WrapPanel>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"
                                   Text="Usa a sua conta e só executa o próprio App Updater."
                                   Style="{DynamicResource CaptionTextStyle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Schedule.StatusMessage}" Style="{DynamicResource OptionalCaptionTextStyle}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Inicialização e bandeja" Style="{DynamicResource SettingsGroupStyle}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding Startup.IsEnabled, Mode=TwoWay}"
                              Command="{Binding Startup.ApplyCommand}"
                              Style="{DynamicResource ToggleSwitchStyle}">
                        <StackPanel>
                            <TextBlock Text="Iniciar com o Windows" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Text="Abre minimizado na área de notificação, sem mostrar a janela."
                                       Style="{DynamicResource OptionalCaptionTextStyle}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="{Binding Startup.StatusMessage}" Style="{DynamicResource OptionalCaptionTextStyle}" />

                    <Rectangle Style="{StaticResource RowSeparatorStyle}" />

                    <CheckBox IsChecked="{Binding Tray.MinimizeToTray, Mode=TwoWay}"
                              Command="{Binding Tray.ApplyCommand}"
                              Style="{DynamicResource ToggleSwitchStyle}">
                        <StackPanel>
                            <TextBlock Text="Minimizar para a bandeja ao fechar" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Text="Fechar a janela só esconde o app. Use Sair no menu da bandeja para encerrar."
                                       Style="{DynamicResource OptionalCaptionTextStyle}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Aplicativos excluídos da atualização" Style="{DynamicResource SettingsGroupStyle}">
                <StackPanel>
                    <TextBlock Text="Não recebem atualizações, nem manuais nem agendadas."
                               TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                    <TextBlock Margin="0,10,0,0" Text="Nenhum aplicativo excluído.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExcludedPackages.HasExcludedPackages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ExcludedPackages.ExcludedPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Rectangle Style="{StaticResource RowSeparatorStyle}" Margin="0,6" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Remover exclusão"
                                                Command="{Binding DataContext.ExcludedPackages.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Remover exclusão do aplicativo"
                                                Style="{DynamicResource PlainButtonStyle}" />
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}">
                                                <Run Text="{Binding Id, Mode=OneWay}" /> • <Run Text="{Binding Source, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
