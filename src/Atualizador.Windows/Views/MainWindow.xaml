<Window x:Class="Atualizador.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Atualizador.Windows.ViewModels"
        mc:Ignorable="d"
        Title="Atualizador Windows"
        Width="1080"
        Height="700"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:UpdatesPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Atualizar lista"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="Atualizar lista de aplicativos"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Content="Abrir Microsoft Store"
                                Command="{Binding OpenStoreCommand}"
                                AutomationProperties.Name="Abrir atualizações da Microsoft Store"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,24,0,0" Padding="14,10" CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource StatusTextStyle}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding CurrentPackageName}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding StoreMessage}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        <ProgressBar Margin="0,10,0,0" Height="5" Minimum="0" Maximum="100"
                                     Value="{Binding UpdateProgress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsUpdating, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,20,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Selecionar todos" Command="{Binding SelectAllCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Content="Limpar seleção" Command="{Binding ClearSelectionCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Content="Atualizar selecionados"
                                Command="{Binding UpdateSelectedCommand}"
                                ToolTip="A execução será habilitada na próxima etapa."
                                Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Content="Cancelar"
                                Command="{Binding CancelUpdateCommand}"
                                ToolTip="Cancelar o processo atual. O instalador externo pode não reverter alterações."
                                Style="{DynamicResource SecondaryButtonStyle}" />
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding SelectedCount, StringFormat={}{0} selecionado(s)}"
                                   Style="{DynamicResource CaptionTextStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSourceFilters}"
                              SelectedItem="{Binding SelectedSourceFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Filtrar por origem"
                              Style="{DynamicResource SettingsComboBoxStyle}" />
                </Grid>

                <Grid Grid.Row="3">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding EmptyStateMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{DynamicResource BodyTextStyle}" />
                    </Border>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackages}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="12,0,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Aplicativo" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Instalada" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Disponível" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Origem" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="5" Text="Estado" Style="{DynamicResource CaptionTextStyle}" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding FilteredPackages}"
                                  Style="{DynamicResource UpdateListStyle}"
                                  ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  AutomationProperties.Name="Lista de atualizações">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Selecionar aplicativo" />
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding AvailableVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Atualizar" Command="{Binding RefreshCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Content="Abrir pasta" Command="{Binding OpenFolderCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Content="Limpar histórico" Command="{Binding ClearCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,24,0,12" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding AvailableDateFilters}"
                              SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Filtrar histórico por data"
                              Style="{DynamicResource SettingsComboBoxStyle}" />
                    <ComboBox Margin="8,0,0,0" ItemsSource="{Binding AvailableStatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Filtrar histórico por status"
                              Style="{DynamicResource SettingsComboBoxStyle}" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ListView ItemsSource="{Binding FilteredEntries}"
                                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  Style="{DynamicResource UpdateListStyle}"
                                  ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                                  AutomationProperties.Name="Lista de histórico">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Style="{DynamicResource StatusTextStyle}" />
                                            <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding FinishedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{DynamicResource CaptionTextStyle}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Message}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Border Grid.Column="2" Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Detalhes" Style="{DynamicResource SectionTitleTextStyle}" />
                                <TextBlock Margin="0,12,0,0" Text="{Binding SelectedEntry.Message}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                                <TextBlock Margin="0,18,0,0" Text="Pacotes" Style="{DynamicResource LabelTextStyle}" />
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedEntry.Packages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SubtleAccentBrush}" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Id}" Style="{DynamicResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <StackPanel MaxWidth="720" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                <TextBlock Margin="0,10,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                <Border Margin="0,28,0,0" Padding="18,14" Background="{DynamicResource SubtleAccentBrush}" CornerRadius="10">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Style="{DynamicResource StatusTextStyle}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="720">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                    <TextBlock Margin="0,10,0,24" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />

                    <GroupBox Header="Aparência" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Tema" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Margin="0,4,0,8" Text="Escolha como o aplicativo deve acompanhar o Windows." Style="{DynamicResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{Binding Appearance.AvailableModes}"
                                      SelectedItem="{Binding Appearance.SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Tema da aplicação"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Cor de destaque" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Cor predefinida" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Margin="0,4,0,8" Text="A cor é aplicada a ações, foco e seleção." Style="{DynamicResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{Binding Appearance.AccentOptions}"
                                      SelectedItem="{Binding Appearance.SelectedAccent, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="Cor de destaque predefinida"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />

                            <TextBlock Margin="0,20,0,0" Text="Cor personalizada em hexadecimal" Style="{DynamicResource LabelTextStyle}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Aplicar"
                                        Command="{Binding Appearance.ApplyCustomAccentCommand}"
                                        AutomationProperties.Name="Aplicar cor personalizada"
                                        Style="{DynamicResource PrimaryButtonStyle}" />
                                <TextBox Text="{Binding Appearance.CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Código hexadecimal da cor"
                                         Style="{DynamicResource SettingsTextBoxStyle}" />
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding Appearance.ValidationMessage}"
                                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Agendamento" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Frequência" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableModes}"
                                      SelectedItem="{Binding Schedule.Mode, Mode=TwoWay}"
                                      AutomationProperties.Name="Frequência do agendamento"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,16,0,0" Text="Intervalo em horas (modo a cada hora)" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableIntervals}"
                                      SelectedItem="{Binding Schedule.IntervalHours, Mode=TwoWay}"
                                      AutomationProperties.Name="Intervalo em horas"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,16,0,0" Text="Dia da semana (modo semanal)" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableDays}"
                                      SelectedItem="{Binding Schedule.DayOfWeek, Mode=TwoWay}"
                                      AutomationProperties.Name="Dia do agendamento semanal"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,16,0,0" Text="Escopo" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableScopes}"
                                      SelectedItem="{Binding Schedule.Scope, Mode=TwoWay}"
                                      AutomationProperties.Name="Escopo do agendamento"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,10,0,0" Text="A tarefa usa a conta atual e não recebe comandos livres." TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                <Button Content="Salvar agendamento" Command="{Binding Schedule.SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                                <Button Margin="8,0,0,0" Content="Desativar" Command="{Binding Schedule.DisableCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Margin="8,0,0,0" Content="Remover" Command="{Binding Schedule.RemoveCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="{Binding Schedule.StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Inicialização"
                              Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Startup.IsEnabled, Mode=TwoWay}"
                                      Content="Iniciar o aplicativo com o Windows"
                                      AutomationProperties.Name="Iniciar com o Windows" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="Desligado por padrão. A opção usa uma tarefa visível e removível do Agendador de Tarefas."
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource CaptionTextStyle}" />
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <Button Content="Aplicar inicialização"
                                        Command="{Binding Startup.ApplyCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding Startup.StatusMessage}"
                                       TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <Button HorizontalAlignment="Left" Content="Restaurar padrão"
                            Command="{Binding Appearance.RestoreDefaultsCommand}"
                            AutomationProperties.Name="Restaurar aparência padrão"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16" Padding="14,10"
                Background="{DynamicResource SubtleAccentBrush}" CornerRadius="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notifications.HasNotification}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Fechar" Command="{Binding DismissNotificationCommand}"
                        AutomationProperties.Name="Fechar notificação" Style="{DynamicResource SecondaryButtonStyle}" />
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding Notifications.Current.Title}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Notifications.Current.Message}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="8,4,8,28">
                <TextBlock Text="Atualizador Windows" Style="{DynamicResource PageTitleTextStyle}" />
                <TextBlock Margin="0,8,0,0" Text="Manutenção simples e segura" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                     ItemContainerStyle="{DynamicResource NavigationItemStyle}" Style="{DynamicResource NavigationListStyle}"
                     KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Navegação principal">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="28" Text="{Binding Glyph}" FontSize="17" TextAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Margin="8,20,8,4" Text=".NET 10 • WPF" Style="{DynamicResource CaptionTextStyle}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Padding="32" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
            <ContentControl Content="{Binding SelectedPage}" AutomationProperties.Name="Conteúdo da página" />
        </Border>
    </Grid>
</Window>
