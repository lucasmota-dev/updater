<Window x:Class="Atualizador.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Atualizador.Windows.ViewModels"
        Title="App Updater"
        Icon="/Atualizador.Windows;component/Assets/Atualizador.ico"
        Width="1080"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!--
        Estrutura da janela:
        ┌────────────────────────────────────────────┐
        │ faixa de aviso (só quando há notificação)  │
        ├──────┬─────────────────────────────────────┤
        │ menu │ página selecionada                  │
        │      │ (layout escolhido pelo DataTemplate │
        │      │  do tipo do ViewModel, abaixo)      │
        ├──────┴─────────────────────────────────────┤
        │ barra de status: nome, versão e estado     │
        └────────────────────────────────────────────┘
        As barras de botões usam WrapPanel: quando a janela fica estreita, os botões
        que não cabem descem para a linha de baixo automaticamente.
    -->
    <Window.Resources>

        <!-- Página Atualizações -->
        <DataTemplate DataType="{x:Type vm:UpdatesPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                </StackPanel>

                <!-- Estado da última operação e progresso -->
                <Border Grid.Row="1" Margin="0,20,0,0" Padding="14,10" CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource StatusTextStyle}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding CurrentPackageName}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        <ProgressBar Margin="0,10,0,0" Height="5" Minimum="0" Maximum="100"
                                     Value="{Binding UpdateProgress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsUpdating, Mode=OneWay}"
                                     Style="{DynamicResource ProgressBarStyle}" />
                    </StackPanel>
                </Border>

                <!-- Ações -->
                <WrapPanel Grid.Row="2" Style="{DynamicResource ActionBarStyle}" Margin="0,16,0,4">
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Buscar atualizações"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Consultar o WinGet e listar os aplicativos com atualização disponível."
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Selecionar todos"
                            Command="{Binding SelectAllCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Limpar seleção"
                            Command="{Binding ClearSelectionCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Atualizar selecionados"
                            Command="{Binding UpdateSelectedCommand}"
                            ToolTip="Atualizar os aplicativos selecionados."
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Excluir da atualização"
                            Command="{Binding ExcludeSelectedCommand}"
                            ToolTip="Não oferecer mais atualizações para os aplicativos selecionados. Desfaça em Configurações."
                            AutomationProperties.Name="Excluir aplicativos selecionados da atualização"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Cancelar"
                            Command="{Binding CancelUpdateCommand}"
                            ToolTip="Cancelar o processo atual. O instalador externo pode não reverter alterações."
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <TextBlock Margin="8,0,8,8" VerticalAlignment="Center"
                               Text="{Binding SelectedCount, StringFormat={}{0} selecionado(s)}"
                               Style="{DynamicResource CaptionTextStyle}" />
                </WrapPanel>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <!-- Lista vazia -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding EmptyStateMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{DynamicResource BodyTextStyle}" />
                    </Border>

                    <!-- Lista de atualizações -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackages}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Cabeçalho: as colunas precisam ser iguais às do ItemTemplate. -->
                        <Grid Margin="12,0,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="Aplicativo" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Instalada" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Disponível" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Origem" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="5" Text="Estado" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding FilteredPackages}"
                                  Style="{DynamicResource UpdateListStyle}"
                                  ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  AutomationProperties.Name="Lista de atualizações">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.4*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{DynamicResource CheckBoxStyle}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding AvailableVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Página Instalar -->
        <DataTemplate DataType="{x:Type vm:InstallPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                </StackPanel>

                <!-- Pesquisa: Enter no campo também pesquisa. -->
                <DockPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Pesquisar" Command="{Binding SearchCommand}"
                            AutomationProperties.Name="Pesquisar aplicativos"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Nome ou ID do aplicativo (ex.: Firefox ou Mozilla.Firefox)"
                             AutomationProperties.Name="Termo de pesquisa do aplicativo"
                             Style="{DynamicResource SettingsTextBoxStyle}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,10" CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource StatusTextStyle}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CurrentPackageName}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        <ProgressBar Margin="0,8,0,0" Height="5" Minimum="0" Maximum="100"
                                     Value="{Binding InstallProgress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsSearching, Mode=OneWay}"
                                     Style="{DynamicResource ProgressBarStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Revise o publicador antes de instalar: estar no catálogo do WinGet não garante que o aplicativo seja seguro."
                                   TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Ações + filtro dos resultados -->
                <DockPanel Grid.Row="3" Margin="0,16,0,4">
                    <TextBox DockPanel.Dock="Right" Width="180" Margin="8,0,0,8" VerticalAlignment="Top"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Filtrar resultados"
                             ToolTip="Filtrar os resultados por nome, ID ou publicador"
                             AutomationProperties.Name="Filtrar resultados da pesquisa"
                             Style="{DynamicResource SettingsTextBoxStyle}" />
                    <WrapPanel Style="{DynamicResource ActionBarStyle}" Margin="0">
                        <Button Margin="{StaticResource ActionItemMargin}" Content="Selecionar todos"
                                Command="{Binding SelectAllCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="{StaticResource ActionItemMargin}" Content="Limpar seleção"
                                Command="{Binding ClearSelectionCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="{StaticResource ActionItemMargin}" Content="Instalar selecionados"
                                Command="{Binding InstallSelectedCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Margin="{StaticResource ActionItemMargin}" Content="Cancelar"
                                Command="{Binding CancelInstallCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <TextBlock Margin="8,0,8,8" VerticalAlignment="Center"
                                   Text="{Binding SelectedCount, StringFormat={}{0} selecionado(s)}"
                                   Style="{DynamicResource CaptionTextStyle}" />
                    </WrapPanel>
                </DockPanel>

                <Border Grid.Row="4" Margin="0,12,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho: as colunas precisam ser iguais às do ItemTemplate. -->
                        <Grid Margin="12,10,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="Aplicativo e publicador" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Identificador (ID)" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Versão" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Origem" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="5" Text="Situação" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                        </Grid>

                        <!-- Sem resultados: orienta o usuário em vez de mostrar uma lista vazia. -->
                        <TextBlock Grid.Row="1" Margin="16,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Nenhum resultado para mostrar. Pesquise um aplicativo pelo nome ou ID."
                                   TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPackages}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListView Grid.Row="1" ItemsSource="{Binding FilteredPackages}"
                                  Style="{DynamicResource UpdateListStyle}"
                                  ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  AutomationProperties.Name="Lista de resultados para instalação">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{DynamicResource CheckBoxStyle}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Publisher}" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Version}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Página Histórico -->
        <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                </StackPanel>

                <!-- Filtros e ações -->
                <WrapPanel Grid.Row="1" Style="{DynamicResource ActionBarStyle}" Margin="0,20,0,4">
                    <ComboBox Margin="{StaticResource ActionItemMargin}" MinWidth="160"
                              ItemsSource="{Binding AvailableDateFilters}"
                              SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay}"
                              ItemTemplate="{StaticResource DisplayTextTemplate}"
                              AutomationProperties.Name="Filtrar histórico por data"
                              Style="{DynamicResource SettingsComboBoxStyle}" />
                    <ComboBox Margin="{StaticResource ActionItemMargin}" MinWidth="160"
                              ItemsSource="{Binding AvailableStatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              ItemTemplate="{StaticResource DisplayTextTemplate}"
                              AutomationProperties.Name="Filtrar histórico por resultado"
                              Style="{DynamicResource SettingsComboBoxStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Recarregar" Command="{Binding RefreshCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Abrir pasta" Command="{Binding OpenFolderCommand}"
                            ToolTip="Abrir a pasta onde o histórico e as preferências ficam salvos."
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="{StaticResource ActionItemMargin}" Content="Limpar histórico" Command="{Binding ClearCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                </WrapPanel>

                <!-- Lista (esquerda) e detalhes do item selecionado (direita) -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ListView ItemsSource="{Binding FilteredEntries}"
                                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  Style="{DynamicResource UpdateListStyle}"
                                  ItemContainerStyle="{DynamicResource UpdateListItemStyle}"
                                  AutomationProperties.Name="Lista de histórico">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                                       Text="{Binding Status, Converter={StaticResource DisplayTextConverter}}"
                                                       Foreground="{DynamicResource AccentBrush}" Style="{DynamicResource StatusTextStyle}" />
                                            <TextBlock Text="{Binding Operation, Converter={StaticResource DisplayTextConverter}}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding FinishedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Style="{DynamicResource CaptionTextStyle}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Message}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Border Grid.Column="2" Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Detalhes" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="0,10,0,0" Text="{Binding SelectedEntry.Message}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />
                                <TextBlock Margin="0,18,0,0" Text="Pacotes" Style="{DynamicResource LabelTextStyle}" />
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedEntry.Packages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SubtleAccentBrush}" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Id}" Style="{DynamicResource CaptionTextStyle}" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Página Configurações -->
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleTextStyle}" />
                    <TextBlock Margin="0,6,0,24" Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}" />

                    <GroupBox Header="Aparência" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Tema" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Margin="0,4,0,8" Text="Escolha como o aplicativo deve acompanhar o Windows." TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{Binding Appearance.AvailableModes}"
                                      SelectedItem="{Binding Appearance.SelectedMode, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DisplayTextTemplate}"
                                      AutomationProperties.Name="Tema do aplicativo"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />

                            <TextBlock Margin="0,20,0,0" Text="Cor de destaque" Style="{DynamicResource LabelTextStyle}" />
                            <TextBlock Margin="0,4,0,8" Text="A cor é aplicada a botões principais, foco e seleção." TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <ComboBox ItemsSource="{Binding Appearance.AccentOptions}"
                                      SelectedItem="{Binding Appearance.SelectedAccent, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="Cor de destaque predefinida"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />

                            <TextBlock Margin="0,20,0,0" Text="Cor personalizada em hexadecimal" Style="{DynamicResource LabelTextStyle}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Aplicar"
                                        Command="{Binding Appearance.ApplyCustomAccentCommand}"
                                        AutomationProperties.Name="Aplicar cor personalizada"
                                        Style="{DynamicResource PrimaryButtonStyle}" />
                                <TextBox Text="{Binding Appearance.CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Exemplo: #0067C0"
                                         AutomationProperties.Name="Código hexadecimal da cor"
                                         Style="{DynamicResource SettingsTextBoxStyle}" />
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding Appearance.ValidationMessage}"
                                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Restaurar aparência padrão"
                                    Command="{Binding Appearance.RestoreDefaultsCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Agendamento" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Frequência" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableModes}"
                                      SelectedItem="{Binding Schedule.Mode, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DisplayTextTemplate}"
                                      AutomationProperties.Name="Frequência do agendamento"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,16,0,0" Text="Intervalo em horas (frequência por intervalo)" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableIntervals}"
                                      SelectedItem="{Binding Schedule.IntervalHours, Mode=TwoWay}"
                                      AutomationProperties.Name="Intervalo em horas"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,16,0,0" Text="Dia da semana (frequência semanal)" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableDays}"
                                      SelectedItem="{Binding Schedule.DayOfWeek, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DisplayTextTemplate}"
                                      AutomationProperties.Name="Dia do agendamento semanal"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,16,0,0" Text="O que atualizar" Style="{DynamicResource LabelTextStyle}" />
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Schedule.AvailableScopes}"
                                      SelectedItem="{Binding Schedule.Scope, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DisplayTextTemplate}"
                                      AutomationProperties.Name="Escopo do agendamento"
                                      Style="{DynamicResource SettingsComboBoxStyle}" />
                            <TextBlock Margin="0,10,0,0" Text="A tarefa do Agendador de Tarefas usa a sua conta e só executa o próprio App Updater." TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <WrapPanel Margin="0,16,0,-8" Style="{DynamicResource ActionBarStyle}">
                                <Button Margin="{StaticResource ActionItemMargin}" Content="Salvar agendamento" Command="{Binding Schedule.SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                                <Button Margin="{StaticResource ActionItemMargin}" Content="Desativar" Command="{Binding Schedule.DisableCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Margin="{StaticResource ActionItemMargin}" Content="Remover" Command="{Binding Schedule.RemoveCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,0" Text="{Binding Schedule.StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Inicialização" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Startup.IsEnabled, Mode=TwoWay}"
                                      Style="{DynamicResource CheckBoxStyle}"
                                      Content="Iniciar o aplicativo com o Windows" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="Desligado por padrão. A opção usa uma tarefa visível e removível do Agendador de Tarefas."
                                       TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Aplicar inicialização"
                                    Command="{Binding Startup.ApplyCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding Startup.StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Área de notificação" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Tray.MinimizeToTray, Mode=TwoWay}"
                                      Style="{DynamicResource CheckBoxStyle}"
                                      Content="Minimizar para a bandeja ao fechar" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="O menu da bandeja permite abrir, verificar atualizações, consultar o status e sair."
                                       TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Aplicar bandeja"
                                    Command="{Binding Tray.ApplyCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding Tray.StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Aplicativos excluídos da atualização" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="Os aplicativos desta lista não recebem atualizações, nem manuais nem agendadas. Para voltar a atualizar um deles, remova a exclusão aqui."
                                       TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Nenhum aplicativo excluído da atualização.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExcludedPackages.HasExcludedPackages}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding ExcludedPackages.ExcludedPackages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,6,0,6">
                                                    <Button DockPanel.Dock="Right" Content="Remover exclusão"
                                                            Command="{Binding DataContext.ExcludedPackages.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="Remover exclusão do aplicativo"
                                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionTextStyle}">
                                                            <Run Text="{Binding Id, Mode=OneWay}" /> • Origem: <Run Text="{Binding Source, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Sobre o App Updater" Style="{DynamicResource SettingsGroupStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding AppUpdate.CurrentVersionText}" Style="{DynamicResource LabelTextStyle}" />
                            <CheckBox Margin="0,12,0,0"
                                      IsChecked="{Binding AppUpdate.CheckOnStartup, Mode=TwoWay}"
                                      Style="{DynamicResource CheckBoxStyle}"
                                      Content="Procurar nova versão ao abrir o aplicativo" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="A busca consulta a página de releases do projeto no GitHub. Nenhum dado pessoal ou lista de aplicativos é enviado."
                                       TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                            <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="Buscar nova versão"
                                    Command="{Binding AppUpdate.CheckCommand}"
                                    ToolTip="Procurar uma versão mais nova do App Updater no GitHub e instalá-la."
                                    AutomationProperties.Name="Buscar nova versão do App Updater"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding AppUpdate.StatusMessage}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Padding="20,6" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{DynamicResource CaptionTextStyle}">
                    <Run Text="App Updater" FontWeight="SemiBold" /> • <Run Text="{Binding AppUpdate.CurrentVersionText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="16,0,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           Text="{Binding AppUpdate.StatusMessage}"
                           ToolTip="{Binding AppUpdate.StatusMessage}"
                           Style="{DynamicResource CaptionTextStyle}" />
            </DockPanel>
        </Border>

        <Grid Margin="16,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Faixa de aviso (resultado de operações, nova versão etc.) -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16" Padding="14,10"
                    Background="{DynamicResource SubtleAccentBrush}" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notifications.HasNotification}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Fechar" Command="{Binding DismissNotificationCommand}"
                            AutomationProperties.Name="Fechar aviso" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button DockPanel.Dock="Right" Margin="0,0,8,0" Command="{Binding OpenNotificationLinkCommand}"
                            Content="{Binding Notifications.Current.ActionLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Current.ActionLabel}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Notifications.Current.Title}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Notifications.Current.Message}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Menu lateral: 200 px expandido, só ícones quando recolhido -->
            <DockPanel Grid.Row="1" Grid.Column="0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Width" Value="200" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                <Setter Property="Width" Value="56" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Button DockPanel.Dock="Top" Content="&#xE700;" Command="{Binding ToggleNavigationCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationToggleButtonStyle}">
                            <Setter Property="ToolTip" Value="Recolher menu" />
                            <Setter Property="AutomationProperties.Name" Value="Recolher menu" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                    <Setter Property="ToolTip" Value="Expandir menu" />
                                    <Setter Property="AutomationProperties.Name" Value="Expandir menu" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         ItemContainerStyle="{DynamicResource NavigationItemStyle}" Style="{DynamicResource NavigationListStyle}"
                         KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Navegação principal">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="28" Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Página selecionada -->
            <Border Grid.Row="1" Grid.Column="2" Padding="28" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <ContentControl Content="{Binding SelectedPage}" Focusable="False" AutomationProperties.Name="Conteúdo da página" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
