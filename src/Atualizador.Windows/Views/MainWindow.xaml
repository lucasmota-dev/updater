<Window x:Class="Atualizador.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Atualizador.Windows.ViewModels"
        xmlns:pages="clr-namespace:Atualizador.Windows.Views.Pages"
        Title="App Updater"
        Icon="/Atualizador.Windows;component/Assets/Atualizador.ico"
        Width="1080"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13">
    <!--
        Estrutura da janela:
        ┌────────────────────────────────────────────┐
        │ faixa de aviso (só quando há notificação)  │
        ├──────┬─────────────────────────────────────┤
        │ menu │ página selecionada                  │
        │      │ (um UserControl de Views/Pages,     │
        │      │  escolhido pelo tipo do ViewModel)  │
        ├──────┴─────────────────────────────────────┤
        │ barra de status: nome, versão e estado     │
        └────────────────────────────────────────────┘
        As barras de botões usam WrapPanel: quando a janela fica estreita, os botões
        que não cabem descem para a linha de baixo automaticamente.
    -->
    <!-- Cada tipo de página (ViewModel) é exibido pelo seu UserControl em Views/Pages. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:UpdatesPageViewModel}"><pages:UpdatesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallPageViewModel}"><pages:InstallPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsUpdatePageViewModel}"><pages:WindowsUpdatePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryPageViewModel}"><pages:HistoryPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><pages:SettingsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutPageViewModel}"><pages:AboutPage /></DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Padding="16,4" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Logo do app em 16 px ao lado do nome. É decorativo: o nome já identifica o app. -->
                <Image DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                       Source="/Atualizador.Windows;component/Assets/updater-128.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Focusable="False" AutomationProperties.Name="" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{DynamicResource CaptionTextStyle}">
                    <Run Text="App Updater" FontWeight="SemiBold" /> • <Run Text="{Binding AppUpdate.CurrentVersionText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="16,0,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           Text="{Binding AppUpdate.StatusMessage}"
                           ToolTip="{Binding AppUpdate.StatusMessage}"
                           Style="{DynamicResource CaptionTextStyle}" />
            </DockPanel>
        </Border>

        <Grid Margin="12,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Faixa de aviso (resultado de operações, nova versão etc.) -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12" Padding="12,8"
                    Background="{DynamicResource SubtleAccentBrush}" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notifications.HasNotification}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Fechar" Command="{Binding DismissNotificationCommand}"
                            AutomationProperties.Name="Fechar aviso" Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Command="{Binding OpenNotificationLinkCommand}"
                            Content="{Binding Notifications.Current.ActionLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Current.ActionLabel}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Notifications.Current.Title}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding Notifications.Current.Message}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Menu lateral: 184 px expandido, só ícones quando recolhido -->
            <DockPanel Grid.Row="1" Grid.Column="0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Width" Value="184" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                <Setter Property="Width" Value="46" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Button DockPanel.Dock="Top" Content="&#xE700;" Command="{Binding ToggleNavigationCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavigationToggleButtonStyle}">
                            <Setter Property="ToolTip" Value="Recolher menu" />
                            <Setter Property="AutomationProperties.Name" Value="Recolher menu" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavigationCollapsed}" Value="True">
                                    <Setter Property="ToolTip" Value="Expandir menu" />
                                    <Setter Property="AutomationProperties.Name" Value="Expandir menu" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         ItemContainerStyle="{DynamicResource NavigationItemStyle}" Style="{DynamicResource NavigationListStyle}"
                         KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Navegação principal">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="24" FontSize="15" Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Página selecionada: direto sobre o fundo da janela (surface). Só as listas e os
                 grupos dentro dela são cartões (surface-raised), como pede o design system. -->
            <ContentControl Grid.Row="1" Grid.Column="2" Margin="8,4,0,0"
                            Content="{Binding SelectedPage}" Focusable="False" AutomationProperties.Name="Conteúdo da página" />
        </Grid>
    </DockPanel>
</Window>
