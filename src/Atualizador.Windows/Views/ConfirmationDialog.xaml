<Window x:Class="Atualizador.Windows.Views.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!--
        Confirmação "Sim/Não" no visual do app (substitui a caixa de mensagem do Windows).
        ┌──────────────────────────────────────┐
        │ (?)  Título                          │
        │      Mensagem                        │
        │                       [Não]  [Sim]   │
        └──────────────────────────────────────┘
        Cartão surface-raised com cantos de 12 px. "Não" é o botão padrão (Enter e Esc), por segurança;
        "Sim" é a única ação preenchida. A margem externa deixa espaço para a sombra.
    -->
    <Border Margin="16" Padding="20" MinWidth="360" MaxWidth="480"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ícone de pergunta na cor de destaque. Decorativo: o título já diz do que se trata. -->
            <Border Grid.Row="0" Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0"
                    VerticalAlignment="Top" CornerRadius="16"
                    Background="{DynamicResource SubtleAccentBrush}">
                <TextBlock Text="&#xE897;" Foreground="{DynamicResource AccentBrush}"
                           Style="{DynamicResource IconTextStyle}" />
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,5,0,0" />
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NoButton" Content="_Não" MinWidth="80" IsDefault="True" IsCancel="True"
                        Style="{DynamicResource SecondaryButtonStyle}" />
                <Button Content="_Sim" MinWidth="80" Margin="8,0,0,0"
                        Style="{DynamicResource PrimaryButtonStyle}" Click="OnYesClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
